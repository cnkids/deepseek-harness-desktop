{
  "name": "deepseek-harness-desktop",
  "version": "0.3.1",
  "description": "Electron desktop launcher for DeepSeek Harness with managed Node.js fallback",
  "author": {
    "name": "cnkids and DeepSeek Harness Desktop contributors",
    "email": "rclandy7@gmail.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/cnkids/deepseek-harness-desktop#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cnkids/deepseek-harness-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/cnkids/deepseek-harness-desktop/issues"
  },
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "pretest:coverage": "node -e \"require('node:fs').mkdirSync('coverage', { recursive: true })\"",
    "test:coverage": "node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info",
    "check:environment": "node scripts/check-environment.mjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "semver": "7.8.5",
    "tar": "7.5.22",
    "three": "^0.169.0",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.cnkids.deepseekharnessdesktop",
    "productName": "DeepSeek Harness Desktop",
    "artifactName": "DeepSeek-Harness-Desktop-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json",
      "!node_modules/three/build/three.cjs",
      "!node_modules/three/build/three.module.js",
      "!node_modules/three/build/three.webgpu*.js",
      "!node_modules/three/examples/**",
      "!node_modules/three/src/**"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "portable": {
      "artifactName": "DeepSeek-Harness-Desktop-${version}-portable-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
